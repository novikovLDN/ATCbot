# Copy to .env for docker-compose.
PORT=8080
LOG_LEVEL=info

# Point to the bot's existing Postgres. `host.docker.internal` works on
# Docker Desktop; on Linux use the actual host IP or the docker0 gateway.
PG_DSN=postgres://aggregator:CHANGE_ME@host.docker.internal:5432/atcbot
REDIS_URL=redis://redis:6379

# Cache TTLs (seconds).
CACHE_TTL=300
STALE_TTL=259200
MAP_TTL=3600
NEG_MAP_TTL=60

# Upstream timeout per attempt (ms) + one retry with 100–300ms jitter.
UPSTREAM_TIMEOUT_MS=2000
UPSTREAM_RETRIES=1

# Shared secret for POST /internal/invalidate and — if WEBHOOK_SECRET is
# empty — for POST /internal/webhook. GENERATE with `openssl rand -hex 32`.
INTERNAL_SECRET=CHANGE_ME_LONG_RANDOM

# HMAC secret for Remnawave webhooks. Panel signs the raw JSON body with
# HMAC-SHA256; the digest is sent in WEBHOOK_SIG_HEADER (hex, optionally
# prefixed with `sha256=`). Leave empty to disable HMAC and fall back to
# INTERNAL_SECRET-gated webhook.
WEBHOOK_SECRET=
WEBHOOK_SIG_HEADER=x-remnawave-signature

# Remark shown on the client when a subscription is revoked.
REVOKED_REMARK=Subscription revoked. Contact support.
